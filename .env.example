# ════════════════════════════════════════════════════════════
#  LOCAL DEV  (docker-compose — no API keys needed)
# ════════════════════════════════════════════════════════════
# GCP credentials are mounted from your local gcloud config automatically.
# Just make sure you have run: gcloud auth application-default login

# Providers — already set in docker-compose, listed here for reference
# AUTH_PROVIDER=local (only option)
# STORAGE_PROVIDER=local
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIMENSIONS=384
# LOCAL_JWT_SECRET=local-dev-secret

# ════════════════════════════════════════════════════════════
#  PRODUCTION  (Cloud Run — set these in Secret Manager)
# ════════════════════════════════════════════════════════════
# STORAGE_PROVIDER=gcs
# EMBEDDING_PROVIDER=vertexai
# EMBEDDING_DIMENSIONS=768

# VERTEX_AI_PROJECT=nexus-support-agent
# VERTEX_AI_LOCATION=us-central1
# GCS_BUCKET_NAME=nexus-support-agent-docs
# DATABASE_URL=postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/...
# LOCAL_JWT_SECRET=<strong-random-secret>

# Frontend (production)
# NEXT_PUBLIC_API_URL=https://nexus-backend-xxx-uc.a.run.app

# ════════════════════════════════════════════════════════════
#  EmailJS (optional) — email when a user asks for a human
# ════════════════════════════════════════════════════════════
# Server-side send; enable "API for non-browser applications" in EmailJS.
# Leave empty to disable email; escalations still show in /admin/escalations.
#
# These are the ONLY vars local dev reads from a real .env file (everything else
# is hardcoded in docker-compose.yml): copy this block into a `.env` at the repo
# root — untracked — and `docker compose up -d` picks it up. Production uses the
# same names but its own .env on the server, built from .env.prod.example.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# ESCALATION_NOTIFY_EMAIL=      # mailbox that receives the requests
# EMAILJS_MAX_ATTACH_KB=350     # cap for the chat-transcript PDF (plan limit)
# Origin used for the share/admin links inside the email. In production it also
# becomes the frontend's NEXT_PUBLIC_API_URL at IMAGE BUILD time — changing it
# means rebuilding the frontend image, not just restarting the container.
# PUBLIC_ORIGIN=http://localhost:3000
