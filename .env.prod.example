# ════════════════════════════════════════════════════════════════════════════
#  Nexus Support Agent — PRODUCTION env for docker-compose.prod.yml
#  Copy to ".env" on the server and fill in real values. NEVER commit .env.
#  cp .env.prod.example .env
# ════════════════════════════════════════════════════════════════════════════

# ── App database (pgvector, runs as the "db" compose service) ────────────────
# Strong random password. Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── Auth ─────────────────────────────────────────────────────────────────────
# Strong random secret (the app refuses known-weak values).
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_64_char_hex_secret

# First admin user, seeded automatically on first startup.
ADMIN_EMAIL=admin@nexusqtech.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Allow guest (no-login) access to the chat. true | false
ALLOW_ANONYMOUS=true

# ── Gemini (LLM via Vertex AI) — required even with local embeddings ─────────
# Put the service-account JSON at ./gcp-credentials.json (mounted read-only).
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# ── Public origin & ports ────────────────────────────────────────────────────
# The exact origin users hit through IIS. Baked into the frontend at build time.
# Include the port unless IIS serves Nexus on 443.
#   e.g. https://app-nexusqtech.com:8443   (dedicated free HTTPS port)
PUBLIC_ORIGIN=https://app-nexusqtech.com:8443

# Localhost port the Docker nginx binds to (IIS proxies here). Must be FREE.
# VGD already uses 8080 — pick another free port and match it in iis/web.config.
NGINX_HOST_PORT=8082

# ── Abuse guards for support requests ───────────────────────────────────────
# (Requests themselves are signed-in only — guests can't create them.)
# Real client IP for rate limiting lives 2 hops deep in X-Forwarded-For for the
# IIS(ARR) → nginx → backend chain. Set in docker-compose.prod.yml already.
# TRUSTED_PROXY_HOPS=2
# Refuse new attachment uploads when free disk drops below this (MB).
MIN_FREE_DISK_MB=500
# Startup sweep deletes attachment files of resolved requests older than N days.
ATTACHMENT_RETENTION_DAYS=90

# ── EmailJS (optional) — notifies support when a user asks for a human ───────
# Server-side send. In EmailJS enable "Allow EmailJS API for non-browser
# applications" and paste the private key below. Leave ids empty to disable
# email; requests still show up in the admin panel (/admin/escalations).
# The template should use variables: subject, from_name, contact, reason,
# attachments, conversation, share_link, conversation_link, to_email.
# IMPORTANT: `attachments` carries rendered HTML (a note + links for any files
# too big to bundle, e.g. videos), so it MUST use triple braces {{{attachments}}}
# — double braces would escape the tags and show them as plain text.
# Add TWO "Variable Attachment" entries in the template's Attachments tab:
#   - file name conversacion.pdf, parameter chat_pdf         (the chat transcript)
#   - file name adjuntos.zip,      parameter attachments_zip (the user's uploads)
# Both need a paid EmailJS plan. The PDF + zip share the size cap below; anything
# over it is dropped and that file falls back to a link in the email body — the
# conversation text and share link always go out regardless.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
ESCALATION_NOTIFY_EMAIL=
EMAILJS_MAX_ATTACH_KB=350
